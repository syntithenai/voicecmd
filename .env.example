# voicecmd settings (copy to .env). Empty values fall back to defaults in voicecmd/config.py.

# --- Audio (PipeWire node names; see `pactl list short sources` / `sinks`) ---
# Use the echo-cancelled source from scripts/setup_echo_cancel.sh when installed.
AUDIO_SOURCE=voicecmd_ec_source
# Empty = default sink.
AUDIO_SINK=

# --- Wake word (openWakeWord bundled models: hey_jarvis, hey_mycroft, alexa, hey_marvin) ---
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.42
# Ignore detections on near-silent frames (int16 RMS / 32768).
WAKE_MIN_RMS=0.0015
WAKE_COOLDOWN_MS=2500
# Audio kept from before the wake detection (small so the wake word isn't transcribed).
WAKE_PREROLL_MS=80

# --- Endpointing (WebRTC VAD) ---
VAD_MODE=2
VAD_MIN_SPEECH_MS=100
VAD_MIN_SILENCE_MS=400
LISTEN_TIMEOUT_MS=5000
MAX_UTTERANCE_MS=8000
# After a reply, accept speech without the wake word for this long.
FOLLOWUP_WINDOW_MS=8000
STT_PAD_MS=300

# --- Resident whisper.cpp server (scripts/start_whisper_server.sh reads these too) ---
WHISPER_URL=http://127.0.0.1:10020
# CPU-only base.en fallback (voicecmd-whisper-cpu.service); used when the GPU server hasn't
# answered within WHISPER_HEDGE_MS (e.g. ComfyUI saturating the GPU). Blank to disable.
WHISPER_FALLBACK_URL=http://127.0.0.1:10022
WHISPER_HEDGE_MS=500
WHISPER_CPU_PORT=10022
WHISPER_PORT=10020
WHISPER_THREADS=8
# WHISPER_MODEL_PATH=/home/stever/projects/voicecmd/models/ggml-small.en-q5_1.bin
# Command vocabulary prompt (biases recognition); empty = built-in default.
WHISPER_PROMPT=

# --- TTS (abc2book gateway: Kokoro GPU with Piper fallback) ---
TTS_URL=http://127.0.0.1:8789
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_SPEED=1.1

# --- LLM fallback (LM Studio) ---
LLM_URL=http://127.0.0.1:1234/v1/chat/completions
# gpt-oss-20b (~12 GB in LM Studio) calls tools reliably in ~1-2 s; ibm/granite-4-h-tiny
# (~4 GB) is lighter but tends to invent weather readings instead of calling the tool.
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_S=20
LLM_FILLER_AFTER_S=1.5

# --- Music (abc2book local-resolver + snapserver) ---
ABC2BOOK_URL=http://127.0.0.1:8787
# Must match LOCAL_SERVICE_TOKEN in abc2book/local-resolver/.env
ABC2BOOK_SERVICE_TOKEN=
SNAPSERVER_HOST=127.0.0.1
SNAPSERVER_PORT=1705
# Snapcast client id/name to control volume on (empty = all clients).
SNAPCAST_CLIENT=resolver-host
MUSIC_DUCK_RATIO=0.3
MUSIC_QUEUE_SIZE=10

# --- Weather ---
WEATHER_DATA_DIR=/home/stever/projects/weatherstation/data

# --- ESPHome devices (yogapp/tools/kogan_switches panel, kogan-switches.service) ---
# Device names, whisper vocabulary and LLM tools follow the panel's live list; blank URL disables.
DEVICES_URL=http://127.0.0.1:8790
DEVICES_REFRESH_S=20
# Extra spoken names, e.g. kettle=Jug; pool=Swimming Machine
DEVICE_ALIASES=
# Groups switched together ("turn off the office"). Members are globs over device names, optionally
# limited to a domain (light: / switch:), so renamed or new devices join automatically.
DEVICE_GROUPS=office=light:*office*, *air filter*, *monitor*

# --- Timers ---
ALARM_RING_S=60

# --- Control HTTP (loopback) ---
CONTROL_HOST=127.0.0.1
CONTROL_PORT=10021
EARCONS=true
